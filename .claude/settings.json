{
  "respectGitignore": false,
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(bun:*)",
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(go:*)",
      "Bash(gh:*)",
      "Bash(linear:*)",
      "Bash(jira:*)",
      "Bash(ls:*)",
      "Bash(basename:*)",
      "Bash($CLAUDE_PROJECT_DIR/.claude/scripts/init-worktree.sh:*)",
      "Bash($CLAUDE_PROJECT_DIR/.claude/scripts/sync-main.sh:*)",
      "Bash($CLAUDE_PROJECT_DIR/.claude/scripts/verify-sync.sh:*)",
      "Bash($CLAUDE_PROJECT_DIR/.claude/scripts/create-worktree.sh:*)",
      "Bash($CLAUDE_PROJECT_DIR/.claude/scripts/remove-worktree.sh:*)",
      "Bash($CLAUDE_PROJECT_DIR/.claude/scripts/list-worktrees.sh:*)",
      "Bash($CLAUDE_PROJECT_DIR/.claude/scripts/clone-repo.sh:*)",
      "Bash($CLAUDE_PROJECT_DIR/.claude/scripts/analyze-repo.sh:*)",
      "Bash($CLAUDE_PROJECT_DIR/.claude/scripts/ensure-analysis.sh:*)",
      "Bash($CLAUDE_PROJECT_DIR/.claude/scripts/test-workflow.sh)",
      "Read(worktrees/**)"
    ],
    "deny": [
      "Bash(git push --force)",
      "Bash(git push -f)",
      "Bash(git reset --hard)",
      "Bash(git clean -f)",
      "Bash(rm -rf)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-sync.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-push-verify.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
